# ═══════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT (Online Testing - Render/Neon)
# ═══════════════════════════════════════════════════════════════════
#
# This is an EXAMPLE file showing what variables to set in Render
# DO NOT commit actual credentials to git
# Set these values in Render dashboard → Environment variables
#

# PostgreSQL Connection (Neon Cloud)
PGHOST=your-project.neon.tech
PGPORT=5432
PGUSER=your-neon-user
PGPASSWORD=your-neon-password
PGDATABASE=s88_app

# Server Configuration
PORT=3001
NODE_ENV=production

# API Configuration
API_BASE_URL=https://s88-app-backend.onrender.com
FRONTEND_URL=https://your-vercel-domain.vercel.app

# Logging (optional)
LOG_LEVEL=info
