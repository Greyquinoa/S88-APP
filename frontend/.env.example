# ═══════════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════

# Development (Local)
# VITE_API_BASE_URL=http://localhost:3001

# Production (Online Testing)
# VITE_API_BASE_URL=https://s88-app-backend.onrender.com

# Example: Create .env.local (git-ignored) for local overrides
# Example: Create .env.production (git-ignored) for production builds

# Base path to serve the app under, e.g. when running behind the local
# gateway at /s88. Leave unset for standalone dev (defaults to "/").
# GATEWAY_BASE=/s88/

# When set, shows a "back to home" link in the sidebar pointing here.
# Leave unset for standalone dev (link is hidden).
# VITE_HOME_URL=http://localhost:8080/
